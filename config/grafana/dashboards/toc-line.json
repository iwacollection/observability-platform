        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "toc:payments:failure_ratio5m{cluster=\"$cluster\",business_line=\"toc\",tenant=\"consumer\"}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "\u4e1a\u52a1\uff1aToC \u7ed3\u8d26\u5ef6\u8fdf p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "business:checkout_duration:p95_5m{cluster=\"$cluster\",business_line=\"toc\",tenant=\"consumer\"}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "\u5e73\u53f0\uff1aCollector \u961f\u5217",
