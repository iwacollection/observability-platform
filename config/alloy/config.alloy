// Local node agent. Compose mounts host /proc, /sys, and / at /host/*.
// Kubernetes central nodes use config/alloy/config.k8s.alloy.
// Workload clusters use config/alloy/config.workload.alloy, which is the
// same pipeline with per-node node-exporter discovery.
//
// CLUSTER_NAME, PROMETHEUS_REMOTE_WRITE_URL, and LOKI_PUSH_URL come from
// the process environment. Compose sets them to the local Docker DNS names
// and cluster=local. A workload cluster sets them to the central URLs and
// that cluster's name. The label is attached here, on the way out.
//
// This agent does not scrape application RED metrics. Those arrive from the
// OpenTelemetry Collector via remote write. Pointing an app at Alloy's OTLP
// receiver forwards the same three signals to the collector gateway.

prometheus.exporter.unix "node" {
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"
	rootfs_path = "/host/root"
}

// job alloy-unix is the agent copy of host metrics. Dashboards and alerts
// read job="node" from node_exporter so the two sources are not summed twice.
prometheus.scrape "node" {
	targets         = prometheus.exporter.unix.node.targets
	forward_to      = [prometheus.remote_write.prometheus.receiver]
	scrape_interval = "15s"
	job_name        = "alloy-unix"
}

prometheus.remote_write "prometheus" {
	endpoint {
		url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")

		authorization {
			type        = "Bearer"
			credentials = sys.env("INGEST_TOKEN")
		}
	}

	external_labels = {
		cluster = sys.env("CLUSTER_NAME"),
	}
}

// Same log push the Kubernetes agent uses. Compose has no pod log source;
// application logs go through the collector. The block stays so the local
// agent config shows the central Loki path.
// Loki auth is on. This agent has no per-pod stream, so the platform org
// is a static tenant id. Business logs go through the collector instead.
loki.write "central" {
	endpoint {
		url       = sys.env("LOKI_PUSH_URL")
		tenant_id = "platform"

		authorization {
			type        = "Bearer"
			credentials = sys.env("INGEST_TOKEN")
		}
	}

	external_labels = {
		cluster = sys.env("CLUSTER_NAME"),
	}
}

otelcol.receiver.otlp "apps" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		metrics = [otelcol.exporter.otlp.gateway.input]
		logs    = [otelcol.exporter.otlp.gateway.input]
		traces  = [otelcol.exporter.otlp.gateway.input]
	}
}

otelcol.exporter.otlp "gateway" {
	client {
		endpoint = "otel-collector:4317"

		headers = {
			"authorization" = "Bearer " + sys.env("INGEST_TOKEN"),
		}

		tls {
			insecure = true
		}
	}
}
