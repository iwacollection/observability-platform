      "url": "/d/profiles",
      "keepTime": true
    },
    {
      "title": "Host",
      "type": "link",
      "url": "/d/host",
      "keepTime": true
    },
    {
      "title": "Demo app",
      "type": "link",
      "url": "/d/demo-app",
      "keepTime": true
    }
  ]
}
