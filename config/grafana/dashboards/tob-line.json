      "id": 1,
      "type": "timeseries",
      "title": "\u57fa\u7840\u8bbe\u65bd\uff1a\u8282\u70b9 CPU",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "instance:node_cpu_utilization:ratio{cluster=\"$cluster\"}"
        }
      ]
    },
