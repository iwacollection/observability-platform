# Single list of pinned images. docker-compose.yml and the Kustomize
# manifests must contain these same tags. scripts/config-check.sh checks that.
# Collector 0.162.0 was tagged on 2026-09-29 but the Docker image was not
# published yet; 0.161.0 is the newest tag that exists on Docker Hub.
#
# KUBE_STATE_METRICS_IMAGE runs only on Kubernetes (it needs an API server).
# The same tag string is repeated in docker-compose.yml as a comment so this
# file stays the only pin list.
OTELCOL_IMAGE=otel/opentelemetry-collector-contrib:0.161.0
ALLOY_IMAGE=grafana/alloy:v1.20.1
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.1
LOKI_IMAGE=grafana/loki:3.7.8
TEMPO_IMAGE=grafana/tempo:3.0.3
PYROSCOPE_IMAGE=grafana/pyroscope:2.3.1
GRAFANA_IMAGE=grafana/grafana:13.2.3
DEMO_BASE_IMAGE=python:3.12.12-slim
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
REDIS_IMAGE=redis:7.4.6
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.74.0
POSTGRES_IMAGE=postgres:17.6
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.17.1
NGINX_IMAGE=nginx:1.28.0
NGINX_EXPORTER_IMAGE=nginx/nginx-prometheus-exporter:1.4.2
KAFKA_IMAGE=apache/kafka:3.9.1
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.9.0
KUBE_STATE_METRICS_IMAGE=registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.16.0
