# Single list of pinned images. docker-compose.yml and the Kustomize
# manifests must contain these same tags. scripts/config-check.sh checks that.
# Collector 0.162.0 was tagged on 2026-09-29 but the Docker image was not
# published yet; 0.161.0 is the newest tag that exists on Docker Hub.
OTELCOL_IMAGE=otel/opentelemetry-collector-contrib:0.161.0
ALLOY_IMAGE=grafana/alloy:v1.20.1
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.1
LOKI_IMAGE=grafana/loki:3.7.8
TEMPO_IMAGE=grafana/tempo:3.0.3
PYROSCOPE_IMAGE=grafana/pyroscope:2.3.1
GRAFANA_IMAGE=grafana/grafana:13.2.3
DEMO_BASE_IMAGE=python:3.12.12-slim
