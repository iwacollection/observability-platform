# Copy to deploy/docker-compose/.env if you want to override Compose interpolation.
# .env is gitignored. The password below is the insecure localhost default.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Ingest credential for the local gateway. Not for production.
# Compose defaults to this same placeholder when the variable is unset.
# Send it as: Authorization: Bearer <INGEST_TOKEN>
INGEST_TOKEN=dev-ingest-token
